# Original compressed archives (source folders already extracted and tracked)
*.rar
*.zip

# Local reference guides (kept on this machine only, not versioned)
*.pdf

# OS artifacts
Thumbs.db
.DS_Store

# Editor/IDE
.vscode/
.idea/

# Firebase backup tool: real secrets/config/output must never be committed
node_modules/
firebase-backup/config.json
firebase-backup/secrets/
firebase-backup/backups/
firebase-backup/backup.log
audit-tools/emu/real.rules.json

# Audit-tool dependencies (acorn, playwright-core) are installed on demand per
# the runbook. Never commit them: Netlify publishes the repo root as static
# files and would try to npm install a package.json it finds there.
/package.json
/package-lock.json

# ឯកសារស្រមោលបណ្តោះអាសន្នរបស់ audit-tools/exit-code-integrity.js
# (ការរត់ដែលត្រូវសម្លាប់អាចបន្សល់វា — វាមិនត្រូវចូល repo ឡើយ)
audit-tools/.tmp-poison-*
