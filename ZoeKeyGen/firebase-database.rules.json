{
  "rules": {
    ".read": false,
    ".write": false,

    "user_roles": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false,
        ".validate": "newData.isString() && newData.val() === 'admin'"
      }
    },

    "license_keys": {
      ".read": true,
      "$appCode": {
        ".validate": "$appCode === 'ADM' || $appCode === 'ZOW' || $appCode === 'SCN'",
        "$keyId": {
          ".write": "auth != null && root.child('user_roles').child(auth.uid).val() === 'admin'",
          "expiresAt": { ".validate": "newData.isNumber() && newData.val() > 0" },
          "revoked":   { ".validate": "newData.isBoolean()" },
          "$other": { ".validate": false }
        }
      }
    },

    "license_keys_meta": {
      ".read": "auth != null && root.child('user_roles').child(auth.uid).val() === 'admin'",
      "$appCode": {
        ".validate": "$appCode === 'ADM' || $appCode === 'ZOW' || $appCode === 'SCN'",
        "$keyId": {
          ".write": "auth != null && root.child('user_roles').child(auth.uid).val() === 'admin'",
          "issuedAt":  { ".validate": "newData.isNumber() && newData.val() > 0" },
          "scope":     { ".validate": "newData.isString() && (newData.val() === 'ADM' || newData.val() === 'ZOW' || newData.val() === 'SCN' || newData.val() === 'ALL')" },
          "note":      { ".validate": "newData.isString()" },
          "createdBy": { ".validate": "newData.isString()" },
          "appPaths": {
            "$idx": { ".validate": "newData.isString() && (newData.val() === 'ADM' || newData.val() === 'ZOW' || newData.val() === 'SCN')" }
          },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
