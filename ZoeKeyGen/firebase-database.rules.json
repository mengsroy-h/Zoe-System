{
  "rules": {
    ".read": false,
    ".write": false,

    "user_roles": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false,
        ".validate": "newData.isString() && newData.val() === 'admin'"
      }
    },

    "license_keys": {
      ".read": "auth != null && root.child('user_roles').child(auth.uid).val() === 'admin'",
      "$appCode": {
        ".validate": "$appCode === 'ZOE'",
        "$keyId": {
          ".read": true,
          ".write": "auth != null && root.child('user_roles').child(auth.uid).val() === 'admin'",
          "expiresAt":  { ".validate": "newData.isNumber() && newData.val() > 0" },
          "revoked":    { ".validate": "newData.isBoolean()" },
          "maxDevices": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5" },
          "$other": { ".validate": false }
        }
      }
    },

    "license_seats": {
      ".read": "auth != null && root.child('user_roles').child(auth.uid).val() === 'admin'",
      "$appCode": {
        ".validate": "$appCode === 'ZOE'",
        "$keyId": {
          ".read": true,
          ".write": "auth != null && root.child('user_roles').child(auth.uid).val() === 'admin'",
          "$slot": {
            ".write": "(auth != null && root.child('user_roles').child(auth.uid).val() === 'admin') || (newData.exists() && root.child('license_keys').child($appCode).child($keyId).exists() && (!data.exists() || data.child('device').val() === newData.child('device').val()))",
            ".validate": "newData.hasChildren(['device', 'at']) && $keyId.length >= 16 && $keyId.length <= 40 && ($slot === 'd1' || ($slot === 'd2' && root.child('license_keys').child($appCode).child($keyId).child('maxDevices').val() >= 2) || ($slot === 'd3' && root.child('license_keys').child($appCode).child($keyId).child('maxDevices').val() >= 3) || ($slot === 'd4' && root.child('license_keys').child($appCode).child($keyId).child('maxDevices').val() >= 4) || ($slot === 'd5' && root.child('license_keys').child($appCode).child($keyId).child('maxDevices').val() >= 5))",
            "device": { ".validate": "newData.isString() && newData.val().length >= 8 && newData.val().length <= 64" },
            "at":     { ".validate": "newData.isNumber() && newData.val() > 0" },
            "$other": { ".validate": false }
          }
        }
      }
    },
    "license_announcements": {
      "$appCode": {
        ".read": true,
        ".validate": "$appCode === 'ZOE'",
        "$msgId": {
          ".write": "auth != null && root.child('user_roles').child(auth.uid).val() === 'admin'",
          ".validate": "newData.hasChildren(['kind', 'title', 'at']) && $msgId.matches(/^n[0-9]{13}[a-z0-9]{6}$/)",
          "kind":  { ".validate": "newData.isString() && (newData.val() === 'notice' || newData.val() === 'maintenance')" },
          "title": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 120" },
          "body":  { ".validate": "newData.isString() && newData.val().length <= 600" },
          "at":    { ".validate": "newData.isNumber() && newData.val() > 0" },
          "$other": { ".validate": false }
        }
      }
    },
    "license_keys_meta": {
      ".read": "auth != null && root.child('user_roles').child(auth.uid).val() === 'admin'",
      "$appCode": {
        ".validate": "$appCode === 'ZOE'",
        "$keyId": {
          ".write": "auth != null && root.child('user_roles').child(auth.uid).val() === 'admin'",
          "issuedAt":  { ".validate": "newData.isNumber() && newData.val() > 0" },
          "scope":     { ".validate": "newData.isString() && (newData.val() === 'ZOE' || newData.val() === 'ALL')" },
          "note":      { ".validate": "newData.isString()" },
          "createdBy": { ".validate": "newData.isString()" },
          "appPaths": {
            "$idx": { ".validate": "newData.isString()" }
          },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
