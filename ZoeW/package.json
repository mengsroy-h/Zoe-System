{
  "name": "zoew",
  "private": true,
  "version": "2.50.202",
  "description": "ZoeW — ប្រព័ន្ធគ្រប់គ្រងអីវ៉ាន់ (React + Vite)",
  "engines": {
    "node": "^22.17.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "build:only": "vite build",
    "notice:check": "node ../tools/audit-tools/zoew/scripts/notice-check.mjs",
    "preview": "vite preview",
    "build:android": "tsc -p tsconfig.app.json --noEmit && vite build --mode android",
    "android:icons": "node scripts/android-icons.mjs",
    "android:sync": "npm run build:android && cap sync android",
    "android:open": "cap open android",
    "typecheck": "tsc -b --noEmit",
    "lint": "cd .. && node ZoeW/node_modules/eslint/bin/eslint.js --config ZoeW/eslint.config.mjs ZoeW tools/audit-tools/zoew",
    "test": "vitest run --config ../tools/audit-tools/zoew/vitest.config.mts",
    "test:watch": "vitest --config ../tools/audit-tools/zoew/vitest.config.mts",
    "verify": "npm run typecheck && npm run lint && npm run slot:check && npm run purity:check && npm run test && npm run build:only && npm run notice:check && npm run smoke && npm run sw:check && npm run doc:check && npm run android:check && npm run native:check",
    "smoke": "node ../tools/audit-tools/zoew/scripts/smoke.mjs",
    "audit:build": "node ../tools/audit-tools/zoew/scripts/build-audit.mjs",
    "sw:check": "node ../tools/audit-tools/zoew/scripts/sw-check.mjs",
    "doc:check": "node ../tools/audit-tools/zoew/scripts/doc-check.mjs",
    "slot:check": "node ../tools/audit-tools/zoew/scripts/slot-ownership-check.mjs",
    "purity:check": "node ../tools/audit-tools/zoew/scripts/react-purity-check.mjs",
    "android:check": "node ../tools/audit-tools/zoew/scripts/android-check.mjs",
    "native:check": "node ../tools/audit-tools/zoew/scripts/native-check.mjs && node ../tools/audit-tools/zoew/scripts/history-window-check.mjs",
    "rules:check": "node ../tools/audit-tools/zoew/scripts/cleanup-rules-check.mjs",
    "money:core": "node ../tools/audit-tools/zoew/scripts/build-audit.mjs && node ../tools/audit-tools/money-reality-check.js --emit-core dist-audit/ZoeW/app.js ../tools/audit-tools/money-core.js",
    "postinstall": "node ../tools/audit-tools/zoew/prepare-dependencies.mjs",
    "pretypecheck": "node ../tools/audit-tools/zoew/prepare-dependencies.mjs",
    "prelint": "node ../tools/audit-tools/zoew/prepare-dependencies.mjs",
    "pretest": "node ../tools/audit-tools/zoew/prepare-dependencies.mjs",
    "pretest:watch": "node ../tools/audit-tools/zoew/prepare-dependencies.mjs",
    "prebuild": "node ../tools/audit-tools/zoew/prepare-dependencies.mjs",
    "prebuild:android": "node ../tools/audit-tools/zoew/prepare-dependencies.mjs",
    "preaudit:build": "node ../tools/audit-tools/zoew/prepare-dependencies.mjs"
  },
  "dependencies": {
    "@netlify/aws-lambda-compat": "2.0.3",
    "@netlify/blobs": "11.1.3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capgo/capacitor-native-biometric": "^8.7.0",
    "@capgo/capacitor-printer": "^8.1.4",
    "@eslint/js": "^10.0.1",
    "@netlify/zip-it-and-ship-it": "16.5.1",
    "@supabase/supabase-js": "2.117.2",
    "@tanstack/react-virtual": "3.14.13",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "acorn": "^8.18.0",
    "acorn-walk": "^8.3.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase": "12.19.0",
    "globals": "^17.13.0",
    "happy-dom": "21.0.4",
    "playwright-core": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    },
    "@grpc/grpc-js": "1.13.6",
    "source-map-js": "1.2.2",
    "re2js": "2.8.7",
    "glob@>=9.0.0 <=14.0.1": "14.0.2",
    "minimatch@>=7.0.0 <11.0.1": "11.0.1"
  },
  "allowScripts": {
    "@firebase/util@1.15.3": true,
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true
  }
}
