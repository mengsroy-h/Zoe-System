{
  "name": "zoew",
  "private": true,
  "version": "2.50.40",
  "description": "ZoeW — ប្រព័ន្ធគ្រប់គ្រងអីវ៉ាន់ (React + Vite)",
  "engines": {
    "node": "^22.17.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noEmit && vite build",
    "build:only": "vite build",
    "notice:check": "node scripts/notice-check.mjs",
    "preview": "vite preview",
    "build:android": "tsc -b --noEmit && vite build --mode android",
    "android:icons": "node scripts/android-icons.mjs",
    "android:sync": "npm run build:android && cap sync android",
    "android:open": "cap open android",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run slot:check && npm run purity:check && npm run test && npm run build:only && npm run notice:check && npm run smoke && npm run sw:check && npm run doc:check && npm run android:check && npm run native:check",
    "smoke": "node scripts/smoke.mjs",
    "audit:build": "node scripts/build-audit.mjs",
    "sw:check": "node scripts/sw-check.mjs",
    "doc:check": "node scripts/doc-check.mjs",
    "slot:check": "node scripts/slot-ownership-check.mjs",
    "purity:check": "node scripts/react-purity-check.mjs",
    "android:check": "node scripts/android-check.mjs",
    "native:check": "node scripts/native-check.mjs && node scripts/history-window-check.mjs",
    "rules:check": "node scripts/cleanup-rules-check.mjs",
    "money:core": "node scripts/build-audit.mjs && node ../audit-tools/money-reality-check.js --emit-core dist-audit/ZoeW/app.js ../audit-tools/money-core.js"
  },
  "dependencies": {
    "@netlify/blobs": "11.1.3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capgo/capacitor-native-biometric": "^8.7.0",
    "@capgo/capacitor-printer": "^8.1.4",
    "@eslint/js": "^10.0.1",
    "@supabase/supabase-js": "2.117.2",
    "@tanstack/react-virtual": "3.14.13",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "acorn": "^8.18.0",
    "acorn-walk": "^8.3.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase": "12.19.0",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "playwright-core": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
