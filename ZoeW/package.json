{
  "name": "zoew",
  "private": true,
  "version": "2.38.0",
  "description": "ZoeW — ប្រព័ន្ធគ្រប់គ្រងអីវ៉ាន់ (React + Vite)",
  "engines": {
    "node": "^22.17.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noEmit && vite build",
    "build:only": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "parity": "node scripts/parity-static.mjs",
    "verify": "npm run typecheck && npm run lint && npm run slot:check && npm run test && npm run build:only && npm run parity && npm run smoke && npm run sw:check && npm run doc:check",
    "parity:dom": "node scripts/parity-dom.mjs",
    "parity:live": "node scripts/parity-live.mjs",
    "parity:all": "npm run parity && npm run parity:dom && npm run parity:live && npm run parity:deep",
    "smoke": "node scripts/smoke.mjs",
    "audit:build": "node scripts/build-audit.mjs",
    "audit:run": "node scripts/run-audit-tools.mjs",
    "generate": "bash tools/generate.sh",
    "package": "bash scripts/package.sh",
    "sw:check": "node scripts/sw-check.mjs",
    "doc:check": "node scripts/doc-check.mjs",
    "parity:deep": "node scripts/parity-deep.mjs",
    "slot:check": "node scripts/slot-ownership-check.mjs",
    "original:fetch": "bash scripts/fetch-original.sh",
    "logic:check": "node scripts/logic-identity.mjs"
  },
  "dependencies": {
    "@netlify/blobs": "11.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "acorn": "^8.18.0",
    "acorn-walk": "^8.3.5",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.5.0",
    "happy-dom": "^20.0.0",
    "playwright-core": "^1.63.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
