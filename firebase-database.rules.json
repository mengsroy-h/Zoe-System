        },
        "clearClaim": {
          ".validate": "!newData.parent().child('restoreClaimId').exists() && !newData.parent().child('restoreClaimToken').exists() && newData.hasChildren(['token','claimedAt']) && newData.child('token').isString() && newData.child('claimedAt').isNumber()",
