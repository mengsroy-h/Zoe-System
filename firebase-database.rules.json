    "zoew_restore_finalizations": {
      ".read": "auth != null",
      "$sourceId": {
        ".write": "auth != null && ((newData.exists() && root.child('zoew_recently_deleted_cod_dod').child($sourceId).child('restoreClaim').child('token').val() === newData.child('token').val() && root.child('zoew_recently_deleted_cod_dod').child($sourceId).child('restoreClaim').child('targetId').val() === newData.child('targetId').val() && root.child('zoew_scan_history_cod_dod').child(newData.child('targetId').val()).child('restoreClaimId').val() === $sourceId && root.child('zoew_scan_history_cod_dod').child(newData.child('targetId').val()).child('restoreClaimToken').val() === newData.child('token').val() && !newData.parent().parent().child('zoew_recently_deleted_cod_dod').child($sourceId).exists() && newData.parent().parent().child('zoew_scan_history_cod_dod').child(newData.child('targetId').val()).exists() && !newData.parent().parent().child('zoew_scan_history_cod_dod').child(newData.child('targetId').val()).child('restoreClaimId').exists() && !newData.parent().parent().child('zoew_scan_history_cod_dod').child(newData.child('targetId').val()).child('restoreClaimToken').exists()) || (data.exists() && !newData.exists() && !root.child('zoew_recently_deleted_cod_dod').child($sourceId).exists()))",
