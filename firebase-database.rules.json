{
  "rules": {
    ".read": false,
    ".write": false,

    "user_roles": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('user_roles').child(auth.uid).val() === 'admin')",
        ".write": false,
        ".validate": "newData.isString() && (newData.val() === 'admin' || newData.val() === 'worker')"
      }
    },

    "zoew_scan_history_cod_dod": {
      ".read": "auth != null && root.child('user_roles').child(auth.uid).exists()",
      "$itemId": {
        ".write": "auth != null && root.child('user_roles').child(auth.uid).exists()",
        "cod":   { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "dod":   { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "price": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "count": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "phone": { ".validate": "newData.isString()" },
        "barcode": { ".validate": "newData.isString()" },
        "locker": { ".validate": "newData.isString()" },
        "isClosed": { ".validate": "newData.isBoolean()" },
        "isCalled": { ".validate": "newData.isBoolean()" },
        "callMark": { ".validate": "newData.isString()" },
        "barcodes": {
          "$idx": {
            "cod":    { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "dod":    { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "code":   { ".validate": "newData.isString()" },
            "locker": { ".validate": "newData.isString()" },
            "isClosed":   { ".validate": "newData.isBoolean()" },
            "isDeducted": { ".validate": "newData.isBoolean()" }
          }
        }
      }
    },

    "zoew_recently_deleted_cod_dod": {
      ".read": "auth != null && root.child('user_roles').child(auth.uid).exists()",
      "$itemId": {
        ".write": "auth != null && root.child('user_roles').child(auth.uid).exists()"
      }
    },

    "zoew_daily_revenue_cod_dod": {
      ".read": "auth != null && root.child('user_roles').child(auth.uid).exists()",
      "$date": {
        ".write": "auth != null && root.child('user_roles').child(auth.uid).exists()",
        "codDollar":  { ".validate": "newData.isNumber()" },
        "dodDollar":  { ".validate": "newData.isNumber()" },
        "totalCount": { ".validate": "newData.isNumber()" }
      }
    },

    "zoew_monthly_revenue_cod_dod": {
      ".read": "auth != null && root.child('user_roles').child(auth.uid).exists()",
      "$month": {
        ".write": "auth != null && root.child('user_roles').child(auth.uid).exists()",
        "codDollar":  { ".validate": "newData.isNumber()" },
        "dodDollar":  { ".validate": "newData.isNumber()" },
        "totalCount": { ".validate": "newData.isNumber()" }
      }
    },

    "zoew_settings": {
      "exchange_rate": {
        ".read": "auth != null && root.child('user_roles').child(auth.uid).exists()",
        ".write": "auth != null && root.child('user_roles').child(auth.uid).val() === 'admin'",
        ".validate": "newData.isNumber() && newData.val() > 0"
      }
    }
  }
}
