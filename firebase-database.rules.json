        "pickedUpBarcodes": {
          ".validate": "newData.hasChildren()",
          "$barcodeKey": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 64"
          }
        },
        "pickupRevision": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 9007199254740990 && newData.val() % 1 === 0"
        },
        "pickupResetEpoch": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9007199254740990 && newData.val() % 1 === 0"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "zoew_daily_collected_cod_dod": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".validate": "newData.hasChildren()",
      "$date": {
        ".validate": "newData.hasChildren()",
        "$barcodeKey": {
          ".validate": "newData.hasChildren()",
          "c": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "d": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "zoew_monthly_revenue_cod_dod": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".validate": "newData.hasChildren()",
      "$month": {
        ".validate": "newData.hasChildren()",
        "codDollar": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "dodDollar": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "totalCount": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "op": {
          ".validate": "newData.isString() && newData.val().length >= 8 && newData.val().length <= 40"
        },
        "ops": {
          ".validate": "newData.hasChildren()",
          "$op": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && $op.length >= 8 && $op.length <= 40"
          }
        },
        "ded": {
          ".validate": "newData.hasChildren()",
          "$trashId": {
            ".validate": "newData.hasChildren(['at','cod','dod','count']) && $trashId.length >= 1 && $trashId.length <= 64",
            "at": {
              ".validate": "newData.isNumber() && newData.val() > 0"
            },
            "cod": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "dod": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "count": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "back": {
              ".validate": "newData.isBoolean() && newData.val() === true"
            },
            "undo": {
              ".validate": "newData.isBoolean() && newData.val() === true"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "zoew_settings": {
      "exchange_rate": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "newData.isNumber() && newData.val() > 0"
      },
      "zto_signed_sweep": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['activeAt'])",
        "activeAt": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= now + 600000"
        },
        "completeAt": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= now + 600000"
        },
        "$other": {
          ".validate": false
        }
      },
      "zto_trash_mode": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "newData.hasChildren()",
        "palm": {
          ".validate": "newData.hasChildren()",
          "$device": {
            ".validate": "$device.length >= 8 && $device.length <= 32 && newData.isNumber() && newData.val() > 0 && newData.val() <= now + 600000"
          }
        },
        "cookie": {
          ".validate": "newData.hasChildren()",
          "$device": {
            ".validate": "$device.length >= 8 && $device.length <= 32 && newData.isNumber() && newData.val() > 0 && newData.val() <= now + 600000"
          }
        },
        "$other": {
          ".validate": false
        }
      },
      "zto_sweep_lead": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "newData.hasChildren()",
        "$lane": {
          ".validate": "$lane.length >= 6 && $lane.length <= 47 && newData.hasChildren(['device', 'at'])",
          "device": {
            ".validate": "newData.isString() && newData.val().length >= 8 && newData.val().length <= 32"
          },
          "at": {
            ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now + 600000"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "zoew_barcode_registry": {
      ".read": "auth != null",
      "$barcodeKey": {
        ".write": "auth != null",
        ".validate": "newData.isBoolean() && newData.val() === true"
      }
    },
    "zoew_write_receipts": {
      "$operation": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && !newData.exists() && data.child('uid').val() === auth.uid && data.child('at').val() < now - 172800000))",
        ".validate": "newData.hasChildren(['uid', 'at', 'hash'])",
        "uid": {
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },
        "at": {
          ".validate": "newData.isNumber() && newData.val() <= now && newData.val() >= now - 60000"
        },
        "hash": {
          ".validate": "newData.isString() && newData.val().length === 64"
        },
        "$other": {
          ".validate": false
        }
      },
      ".read": "auth != null"
    }
  }
}
