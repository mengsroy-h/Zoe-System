            },
            "$other": {
              ".validate": false
            }
          }
        },
        "restoreClaimId": {
          ".validate": "newData.isString() && !newData.parent().child('clearClaim').exists() && newData.parent().child('restoreClaimToken').isString() && root.child('zoew_recently_deleted_cod_dod').child(newData.val()).child('restoreClaim').child('token').isString() && root.child('zoew_recently_deleted_cod_dod').child(newData.val()).child('restoreClaim').child('token').val() === newData.parent().child('restoreClaimToken').val() && root.child('zoew_recently_deleted_cod_dod').child(newData.val()).child('restoreClaim').child('targetId').val() === $itemId"
        },
        "restoreClaimToken": {
