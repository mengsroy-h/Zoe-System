{
  "rules": {
    ".read": false,
    ".write": false,

    "user_roles": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('user_roles').child(auth.uid).val() === 'admin')",
        ".write": false,
        ".validate": "newData.isString() && (newData.val() === 'admin' || newData.val() === 'worker' || newData.val() === 'scanner')"
      }
    },

    "zoew_scan_history_cod_dod": {
      ".read": "auth != null && (root.child('user_roles').child(auth.uid).val() === 'admin' || root.child('user_roles').child(auth.uid).val() === 'worker')",
      "$itemId": {
        ".write": "auth != null && (root.child('user_roles').child(auth.uid).val() === 'admin' || (root.child('user_roles').child(auth.uid).val() === 'worker' && (newData.exists() || (data.child('isClosed').val() === true && data.child('closedAt').exists() && (now - data.child('closedAt').val()) > 7200000) || (data.child('isClosed').val() !== true && data.child('createdAt').exists() && (now - data.child('createdAt').val()) > 691200000))) || (root.child('user_roles').child(auth.uid).val() === 'scanner' && data.exists() && newData.exists()))",
        "id":    { ".validate": "newData.isString() && (root.child('user_roles').child(auth.uid).val() === 'admin' || !data.exists() || newData.val() === data.val())" },
        "cod":   { ".validate": "newData.isNumber() && newData.val() >= 0 && (root.child('user_roles').child(auth.uid).val() !== 'scanner' || !data.exists() || newData.val() === data.val())" },
        "dod":   { ".validate": "newData.isNumber() && newData.val() >= 0 && (root.child('user_roles').child(auth.uid).val() !== 'scanner' || !data.exists() || newData.val() === data.val())" },
        "price": { ".validate": "newData.isNumber() && newData.val() >= 0 && (root.child('user_roles').child(auth.uid).val() !== 'scanner' || !data.exists() || newData.val() === data.val())" },
        "count": { ".validate": "newData.isNumber() && newData.val() >= 0 && (root.child('user_roles').child(auth.uid).val() !== 'scanner' || !data.exists() || newData.val() === data.val())" },
        "phone": { ".validate": "newData.isString() && (root.child('user_roles').child(auth.uid).val() !== 'scanner' || !data.exists() || newData.val() === data.val())" },
        "barcode": { ".validate": "newData.isString() && (root.child('user_roles').child(auth.uid).val() !== 'scanner' || !data.exists() || newData.val() === data.val())" },
        "locker": { ".validate": "newData.isString()" },
        "isClosed": { ".validate": "newData.isBoolean() && (root.child('user_roles').child(auth.uid).val() !== 'scanner' || !data.exists() || newData.val() === data.val())" },
        "isCalled": { ".validate": "newData.isBoolean() && (root.child('user_roles').child(auth.uid).val() !== 'scanner' || !data.exists() || newData.val() === data.val())" },
        "callMark": { ".validate": "newData.isString() && (root.child('user_roles').child(auth.uid).val() !== 'scanner' || !data.exists() || newData.val() === data.val())" },
        "callMarkTime": { ".validate": "newData.isNumber() && (root.child('user_roles').child(auth.uid).val() !== 'scanner' || !data.exists() || newData.val() === data.val())" },
        "createdAt": { ".validate": "newData.isNumber() && (root.child('user_roles').child(auth.uid).val() === 'admin' || !data.exists() || newData.val() === data.val())" },
        "closedAt": { ".validate": "newData.isNumber() && (root.child('user_roles').child(auth.uid).val() !== 'scanner' || !data.exists() || newData.val() === data.val())" },
        "scanDate": { ".validate": "newData.isString() && (root.child('user_roles').child(auth.uid).val() === 'admin' || !data.exists() || newData.val() === data.val())" },
        "time": { ".validate": "newData.isString() && (root.child('user_roles').child(auth.uid).val() === 'admin' || !data.exists() || newData.val() === data.val())" },
        "lockerUpdatedAt": { ".validate": "newData.isNumber()" },
        "lockerUpdatedBy": { ".validate": "newData.isString()" },
        "barcodes": {
          "$idx": {
            ".validate": "root.child('user_roles').child(auth.uid).val() !== 'scanner' || data.exists()",
            "cod":    { ".validate": "newData.isNumber() && newData.val() >= 0 && (root.child('user_roles').child(auth.uid).val() !== 'scanner' || !data.exists() || newData.val() === data.val())" },
            "dod":    { ".validate": "newData.isNumber() && newData.val() >= 0 && (root.child('user_roles').child(auth.uid).val() !== 'scanner' || !data.exists() || newData.val() === data.val())" },
            "code":   { ".validate": "newData.isString() && (root.child('user_roles').child(auth.uid).val() !== 'scanner' || !data.exists() || newData.val() === data.val())" },
            "locker": { ".validate": "newData.isString()" },
            "isClosed":   { ".validate": "newData.isBoolean() && (root.child('user_roles').child(auth.uid).val() !== 'scanner' || !data.exists() || newData.val() === data.val())" },
            "isDeducted": { ".validate": "newData.isBoolean() && (root.child('user_roles').child(auth.uid).val() !== 'scanner' || !data.exists() || newData.val() === data.val())" },
            "isFromDeletion": { ".validate": "newData.isBoolean() && (root.child('user_roles').child(auth.uid).val() !== 'scanner' || !data.exists() || newData.val() === data.val())" },
            "time": { ".validate": "newData.isString() && (root.child('user_roles').child(auth.uid).val() !== 'scanner' || !data.exists() || newData.val() === data.val())" },
            "createdAt": { ".validate": "newData.isNumber() && (root.child('user_roles').child(auth.uid).val() !== 'scanner' || !data.exists() || newData.val() === data.val())" },
            "lockerUpdatedAt": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    },

    "zoew_scanner_lookup": {
      ".read": "auth != null && root.child('user_roles').child(auth.uid).exists()",
      "$itemId": {
        ".write": "auth != null && (root.child('user_roles').child(auth.uid).val() === 'admin' || root.child('user_roles').child(auth.uid).val() === 'worker' || (root.child('user_roles').child(auth.uid).val() === 'scanner' && data.exists() && newData.exists()))",
        "id":    { ".validate": "newData.isString()" },
        "phone": { ".validate": "newData.isString() && (root.child('user_roles').child(auth.uid).val() !== 'scanner' || !data.exists() || newData.val() === data.val())" },
        "barcode": { ".validate": "newData.isString() && (root.child('user_roles').child(auth.uid).val() !== 'scanner' || !data.exists() || newData.val() === data.val())" },
        "locker": { ".validate": "newData.isString()" },
        "lockerUpdatedAt": { ".validate": "newData.isNumber()" },
        "lockerUpdatedBy": { ".validate": "newData.isString()" },
        "barcodes": {
          "$idx": {
            "code":   { ".validate": "newData.isString() && (root.child('user_roles').child(auth.uid).val() !== 'scanner' || !data.exists() || newData.val() === data.val())" },
            "locker": { ".validate": "newData.isString()" },
            "lockerUpdatedAt": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    },

    "zoew_recently_deleted_cod_dod": {
      ".read": "auth != null && (root.child('user_roles').child(auth.uid).val() === 'admin' || root.child('user_roles').child(auth.uid).val() === 'worker')",
      "$itemId": {
        ".write": "auth != null && (root.child('user_roles').child(auth.uid).val() === 'admin' || root.child('user_roles').child(auth.uid).val() === 'worker')",
        "id":    { ".validate": "newData.isString() && (root.child('user_roles').child(auth.uid).val() === 'admin' || !data.exists() || newData.val() === data.val())" },
        "cod":   { ".validate": "newData.isNumber() && newData.val() >= 0 && (root.child('user_roles').child(auth.uid).val() === 'admin' || !data.exists() || newData.val() === data.val())" },
        "dod":   { ".validate": "newData.isNumber() && newData.val() >= 0 && (root.child('user_roles').child(auth.uid).val() === 'admin' || !data.exists() || newData.val() === data.val())" },
        "price": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "count": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "phone": { ".validate": "newData.isString()" },
        "barcode": { ".validate": "newData.isString()" },
        "locker": { ".validate": "newData.isString()" },
        "isClosed": { ".validate": "newData.isBoolean()" },
        "isCalled": { ".validate": "newData.isBoolean()" },
        "callMark": { ".validate": "newData.isString()" },
        "callMarkTime": { ".validate": "newData.isNumber()" },
        "createdAt": { ".validate": "newData.isNumber() && (root.child('user_roles').child(auth.uid).val() === 'admin' || !data.exists() || newData.val() === data.val())" },
        "closedAt": { ".validate": "newData.isNumber()" },
        "scanDate": { ".validate": "newData.isString() && (root.child('user_roles').child(auth.uid).val() === 'admin' || !data.exists() || newData.val() === data.val())" },
        "time": { ".validate": "newData.isString() && (root.child('user_roles').child(auth.uid).val() === 'admin' || !data.exists() || newData.val() === data.val())" },
        "lockerUpdatedAt": { ".validate": "newData.isNumber()" },
        "lockerUpdatedBy": { ".validate": "newData.isString()" },
        "deletedAt": { ".validate": "newData.isNumber() && (root.child('user_roles').child(auth.uid).val() === 'admin' || !data.exists() || newData.val() === data.val())" },
        "isFromDeletion": { ".validate": "newData.isBoolean() && (root.child('user_roles').child(auth.uid).val() === 'admin' || !data.exists() || newData.val() === data.val())" },
        "barcodes": {
          "$idx": {
            "cod":    { ".validate": "newData.isNumber() && newData.val() >= 0 && (root.child('user_roles').child(auth.uid).val() === 'admin' || !data.exists() || newData.val() === data.val())" },
            "dod":    { ".validate": "newData.isNumber() && newData.val() >= 0 && (root.child('user_roles').child(auth.uid).val() === 'admin' || !data.exists() || newData.val() === data.val())" },
            "code":   { ".validate": "newData.isString()" },
            "locker": { ".validate": "newData.isString()" },
            "isClosed":   { ".validate": "newData.isBoolean()" },
            "isDeducted": { ".validate": "newData.isBoolean() && (root.child('user_roles').child(auth.uid).val() === 'admin' || !data.exists() || newData.val() === data.val())" },
            "isFromDeletion": { ".validate": "newData.isBoolean() && (root.child('user_roles').child(auth.uid).val() === 'admin' || !data.exists() || newData.val() === data.val())" },
            "time": { ".validate": "newData.isString() && (root.child('user_roles').child(auth.uid).val() === 'admin' || !data.exists() || newData.val() === data.val())" },
            "createdAt": { ".validate": "newData.isNumber() && (root.child('user_roles').child(auth.uid).val() === 'admin' || !data.exists() || newData.val() === data.val())" },
            "lockerUpdatedAt": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    },

    "zoew_daily_revenue_cod_dod": {
      ".read": "auth != null && (root.child('user_roles').child(auth.uid).val() === 'admin' || root.child('user_roles').child(auth.uid).val() === 'worker')",
      "$date": {
        ".write": "auth != null && (root.child('user_roles').child(auth.uid).val() === 'admin' || root.child('user_roles').child(auth.uid).val() === 'worker')",
        "codDollar":  { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "dodDollar":  { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "totalCount": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "$other": { ".validate": false }
      }
    },

    "zoew_daily_pickup_cod_dod": {
      ".read": "auth != null && (root.child('user_roles').child(auth.uid).val() === 'admin' || root.child('user_roles').child(auth.uid).val() === 'worker')",
      "$date": {
        ".write": "auth != null && (root.child('user_roles').child(auth.uid).val() === 'admin' || root.child('user_roles').child(auth.uid).val() === 'worker')",
        "packagesPickedUp": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "pickedUpPhones": {
          "$phoneKey": { ".validate": "newData.isNumber() && newData.val() > 0" }
        },
        "$other": { ".validate": false }
      }
    },

    "zoew_monthly_revenue_cod_dod": {
      ".read": "auth != null && (root.child('user_roles').child(auth.uid).val() === 'admin' || root.child('user_roles').child(auth.uid).val() === 'worker')",
      ".write": "auth != null && (root.child('user_roles').child(auth.uid).val() === 'admin' || root.child('user_roles').child(auth.uid).val() === 'worker')",
      "$month": {
        "codDollar":  { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "dodDollar":  { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "totalCount": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "$other": { ".validate": false }
      }
    },

    "zoew_settings": {
      "exchange_rate": {
        ".read": "auth != null && (root.child('user_roles').child(auth.uid).val() === 'admin' || root.child('user_roles').child(auth.uid).val() === 'worker')",
        ".write": "auth != null && root.child('user_roles').child(auth.uid).val() === 'admin'",
        ".validate": "newData.isNumber() && newData.val() > 0"
      }
    },

    "zoew_barcode_registry": {
      ".read": "auth != null && (root.child('user_roles').child(auth.uid).val() === 'admin' || root.child('user_roles').child(auth.uid).val() === 'worker')",
      "$barcodeKey": {
        ".write": "auth != null && (root.child('user_roles').child(auth.uid).val() === 'admin' || root.child('user_roles').child(auth.uid).val() === 'worker')",
        ".validate": "newData.isBoolean() && newData.val() === true"
      }
    }
  }
}
